{
    "info": {
        "_postman_id": "germen-latin-market-api",
        "name": "Germen Latin Market API",
        "description": "Colección de pruebas de la API REST de Germen Latin Market.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "token",
            "value": "PEGA_AQUI_UN_TOKEN_VALIDO_SOLO_PARA_PROBAR"
        },
        {
            "key": "productId",
            "value": "ID_DEL_PRODUCTO"
        },
        {
            "key": "orderId",
            "value": "ID_DEL_PEDIDO"
        }
    ],
    "item": [
        {
            "name": "Health",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/health",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "health"
                    ]
                }
            }
        },
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"CONTRASENA_DE_PRUEBA\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Products",
            "item": [
                {
                    "name": "Get Products",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/products",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "products"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Producto de prueba\",\n  \"description\": \"Producto creado para probar la API.\",\n  \"category\": \"Despensa\",\n  \"price\": 3.5,\n  \"stock\": 10,\n  \"image\": \"/images/products/producto-prueba.jpg\",\n  \"featured\": false\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/products",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "products"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Product",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Producto actualizado\",\n  \"description\": \"Producto actualizado desde Postman.\",\n  \"category\": \"Despensa\",\n  \"price\": 4,\n  \"stock\": 8,\n  \"image\": \"/images/products/producto-prueba.jpg\",\n  \"featured\": false\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/products/{{productId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "products",
                                "{{productId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products/{{productId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "products",
                                "{{productId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Orders",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"customerName\": \"Cliente de prueba\",\n  \"email\": \"cliente@ejemplo.com\",\n  \"phone\": \"600000000\",\n  \"address\": \"Calle Ejemplo 1\",\n  \"city\": \"Sevilla\",\n  \"country\": \"España\",\n  \"postalCode\": \"41001\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Producto de prueba\",\n      \"quantity\": 1,\n      \"price\": 4.5\n    }\n  ],\n  \"subtotal\": 4.5,\n  \"shipping\": 4.9,\n  \"total\": 9.4\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "orders"
                            ]
                        }
                    }
                },
                {
                    "name": "My Orders",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/orders/my-orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "orders",
                                "my-orders"
                            ]
                        }
                    }
                },
                {
                    "name": "Get All Orders - Admin",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "orders"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Order Status - Admin",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"processing\",\n  \"isPaid\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "orders",
                                "{{orderId}}",
                                "status"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}